{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/RocketDelivery2/GUMFALL/main/schemas/engine_evaluation_trace.schema.json",
  "title": "Engine Evaluation Determinism Trace",
  "description": "Technology-neutral authoritative-state trace for GUMFALL engine-evaluation Prototype 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "source_sha",
    "engine_version",
    "seed_id",
    "input_hash",
    "initial_state_hash",
    "ticks",
    "final_state_hash"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "candidate": {
      "type": "string",
      "enum": ["unity", "unreal", "godot", "o3de", "custom"]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16,128}$"
    },
    "initial_state_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16,128}$"
    },
    "ticks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tick", "state_hash"],
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "state_hash": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{16,128}$"
          }
        }
      }
    },
    "final_state_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{16,128}$"
    }
  }
}
